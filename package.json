{
  "name": "worksheet-generator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "sample:pdf": "node --experimental-strip-types scripts/create-sample-pdf.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  },
  "engines": { "node": ">=22.12.0" }
}
