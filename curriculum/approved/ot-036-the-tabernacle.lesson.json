    },
    {
      "id": "tf-02",
      "statement": "The Ark of the Covenant was a wooden chest covered in gold.",
      "isTrue": true,
      "origin": "suggested",
      "teacherReviewRequired": true
    },
    {
      "id": "tf-03",
      "statement": "The stone tablets of God’s law were placed inside the ark.",
