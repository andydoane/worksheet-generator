      "origin": "suggested",
      "teacherReviewRequired": true
    },
    {
      "id": "tf-04",
      "statement": "The table in the Holy Place held twelve loaves of bread.",
      "isTrue": true,
      "origin": "suggested",
      "teacherReviewRequired": true
    },
    {
      "id": "tf-05",
      "statement": "The golden lampstand had seven lamps for lighting the tent.",
      "isTrue": true,
      "origin": "suggested",
      "teacherReviewRequired": true
    },
    {
      "id": "tf-06",
      "statement": "The altar of incense was in the Holy Place.",
      "isTrue": true,
      "origin": "suggested",
      "teacherReviewRequired": true
    },
    {
      "id": "tf-07",
      "statement": "Aaron and his sons served as priests in the Tabernacle.",
      "isTrue": true,
      "origin": "suggested",
      "teacherReviewRequired": true
    },
    {
      "id": "tf-08",
      "statement": "God’s glory filled the Tabernacle when it was set up.",
