{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andydoane/worksheet-generator/blob/main/curriculum/schema/lesson-v1.schema.json",
  "title": "Bible Worksheet Studio · Lesson preset v1",
  "description": "Source-preserving curriculum interchange data, NOT a saved worksheet or published preset. Publication requires separate editorial approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "curriculum",
    "lessonDetails",
    "sourceFiles",
    "storyNotes",
    "questions",
    "facts",
    "vocabulary",
    "preparedActivities",
    "moduleReadiness",
    "reviewFlags",
    "publication"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "schemaStatus": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "curriculum": {
      "type": "object",
      "required": [
        "series",
        "lessonNumber"
      ],
      "properties": {
        "series": {
          "type": "string",
          "minLength": 1
        },
        "lessonNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "lessonDetails": {
      "type": "object",
      "required": [
        "title",
        "scripturePassages",
        "scriptureDisplay",
        "bigIdeas",
        "memoryVerse"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scripturePassages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scriptureDisplay": {
          "type": "string",
          "minLength": 1
        },
        "bigIdeas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "origin"
            ],
            "properties": {
              "origin": {
                "$ref": "#/$defs/origin"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "teacherReviewRequired": {
                "type": "boolean"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "memoryVerse": {
          "type": "object",
          "required": [
            "reference",
            "translation",
            "text",
            "isExcerpt"
          ],
          "properties": {
            "origin": {
              "$ref": "#/$defs/origin"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "teacherReviewRequired": {
              "type": "boolean"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "translation": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "isExcerpt": {
              "type": "boolean"
            },
            "hasEllipses": {
              "type": "boolean"
            },
            "requiresTextReview": {
              "type": "boolean"
            },
            "alsoVerifiedAt": {
              "$ref": "#/$defs/source"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sourceFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "filename",
          "format"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
