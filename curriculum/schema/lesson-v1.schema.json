              "odt",
              "odp",
              "pdf",
              "docx",
              "pptx"
            ]
          },
          "role": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "storyNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "originalText",
          "cleanText",
          "emphasizedWords",
          "origin",
          "source"
        ],
        "properties": {
          "origin": {
            "$ref": "#/$defs/origin"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
